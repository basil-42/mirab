---
// Icon-card grid for a feature detail page's item list — replaces the plain
// numbered FeatureRow list with a 2-column grid of cards, each carrying a
// small icon that identifies the feature (not an arbitrary sequence number,
// since these items are independent capabilities, not ordered steps).
interface Item {
  icon: keyof typeof ICONS;
  title: string;
  desc: string;
}
interface Props {
  items: Item[];
  label: string;
}
const { items, label } = Astro.props;

const ICONS = {
  dashboard: '<rect x="3" y="12" width="4" height="8" rx="1"/><rect x="10" y="7" width="4" height="13" rx="1"/><rect x="17" y="3" width="4" height="17" rx="1"/>',
  report: '<path d="M9 17V9M15 17V5M4 21h16"/>',
  export: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h10M7 17h6"/>',
  audit: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  chat: '<path d="M4 4h16v12H9l-5 4V4Z"/>',
  link: '<path d="M9 17H7a5 5 0 0 1 0-10h2M15 7h2a5 5 0 1 1 0 10h-2M8 12h8"/>',
  bulk: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="m3 6 1.3 1.3L6.5 5"/><path d="m3 12 1.3 1.3 2.2-2.3"/><path d="m3 18 1.3 1.3 2.2-2.3"/>',
  signature: '<path d="M3 17c2-4 4-6 6-6s2 4 4 4 3-6 5-6 2 3 3 3"/><path d="M4 21h16"/>',
  users: '<path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19"/><circle cx="9" cy="8" r="3.2"/><path d="M19.5 19v-1.5a3.3 3.3 0 0 0-2.3-3.15"/><path d="M14.7 4.7a3.2 3.2 0 0 1 0 6.1"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  cloud: '<path d="M17.5 19H9a5 5 0 1 1 1.3-9.8A6 6 0 0 1 22 11.5a4.5 4.5 0 0 1-4.5 7.5Z"/>',
  import: '<path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
  alert: '<path d="M12 8v5M12 16h.01"/><circle cx="12" cy="12" r="9"/>',
  sheet: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9.5h18M3 15h18M9.5 4v16M15 4v16"/>',
} as const;
const oddSpan = items.length % 2 === 1;
---

<section class="px-6 md:px-20 py-6 md:py-10">
  <div class="max-w-[900px] mx-auto">
    <div class="text-[12px] font-bold text-navy-500 uppercase tracking-wide mb-4">{label}</div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {items.map((item, i) => (
        <div class:list={["flex flex-col gap-3.5 bg-bg border border-gray-300 rounded-2xl p-6 hover:-translate-y-0.5 hover:shadow-md hover:border-navy-500/30 transition-all", oddSpan && i === items.length - 1 && "md:col-span-2"]}>
          <div class="w-11 h-11 rounded-xl bg-navy-500/10 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2A5490" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[item.icon]} />
          </div>
          <h3 class="text-[16.5px] font-extrabold text-navy-900">{item.title}</h3>
          <p class="text-[13.5px] leading-[1.85] text-gray-600">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
