---
import type { FAQItem } from '../i18n/faq';

interface Props {
  items: FAQItem[];
}
const { items } = Astro.props;
---

<div class="flex flex-col gap-3 max-w-[820px] mx-auto">
  {items.map((item) => (
    <details class="group bg-white border border-gray-300 rounded-xl px-5 py-1 open:pb-4 transition-colors open:border-navy-500/40">
      <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden">
        <span class="text-[15.5px] md:text-[16px] font-semibold text-navy-900">{item.q}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2A5490" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform duration-200 group-open:rotate-45">
          <path d="M12 5v14M5 12h14" />
        </svg>
      </summary>
      <p class="text-[14.5px] leading-[1.9] text-gray-600 pe-8">{item.a}</p>
    </details>
  ))}
</div>
