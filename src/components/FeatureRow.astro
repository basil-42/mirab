---
interface Props {
  number: string;
  title: string;
  description: string;
  reversed?: boolean; // alternate layout direction
}
const { number, title, description, reversed = false } = Astro.props;
---

<div class:list={["flex flex-col md:flex-row gap-6 md:gap-10 py-10 border-b border-gray-300 last:border-0", reversed && "md:flex-row-reverse"]}>
  <div class="shrink-0">
    <div class="w-12 h-12 rounded-xl bg-navy-900 text-white flex items-center justify-center font-bold text-[16px]">
      {number}
    </div>
  </div>
  <div class="flex flex-col gap-2.5 max-w-[720px]">
    <h3 class="text-[21px] md:text-[23px] font-bold text-navy-900">{title}</h3>
    <p class="text-[15.5px] leading-[1.9] text-gray-600">{description}</p>
  </div>
</div>
