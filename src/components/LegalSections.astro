---
import type { LegalSection } from '../i18n/legal';

interface Props {
  sections: LegalSection[];
  lastUpdated: string;
}
const { sections, lastUpdated } = Astro.props;
---

<section class="px-6 md:px-20 py-10 md:py-14">
  <div class="max-w-[760px] mx-auto flex flex-col gap-10">
    <span class="text-[13px] font-medium text-gray-600">{lastUpdated}</span>

    {sections.map((s, i) => (
      <div class="flex flex-col gap-3">
        <h2 class="text-[19px] md:text-[21px] font-bold text-navy-900">{i + 1}. {s.title}</h2>
        {s.paragraphs?.map((p) => (
          <p class="text-[15px] leading-[1.9] text-gray-600">{p}</p>
        ))}
        {s.bullets && (
          <ul class="flex flex-col gap-2.5 ps-5 list-disc marker:text-navy-500">
            {s.bullets.map((b) => (
              <li class="text-[15px] leading-[1.85] text-gray-600">{b}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</section>
