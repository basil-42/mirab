---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="flex flex-col gap-3 max-w-[820px] mx-auto">
  {items.map((item) => (
    <div class="flex items-start gap-4 bg-white border border-gray-300 rounded-xl p-5">
      <div class="shrink-0 w-8 h-8 rounded-full bg-navy-900 flex items-center justify-center">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <p class="text-[15px] leading-[1.85] text-ink pt-0.5">{item}</p>
    </div>
  ))}
</div>
