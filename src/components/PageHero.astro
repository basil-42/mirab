---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaNote?: string;
}
const { eyebrow, title, description, ctaLabel, ctaHref, ctaNote } = Astro.props;
---

<section class="px-6 md:px-20 pt-16 pb-14 md:pt-20 md:pb-16 border-b border-gray-300">
  <div class="max-w-[820px] mx-auto text-center flex flex-col items-center gap-5">
    {eyebrow && (
      <span class="inline-flex items-center gap-2 bg-navy-900/5 text-navy-700 text-[13px] font-semibold px-3.5 py-1.5 rounded-full">
        {eyebrow}
      </span>
    )}
    <h1 class="text-[34px] md:text-[44px] font-bold leading-[1.3] text-navy-900">{title}</h1>
    <p class="text-[16px] md:text-[17px] leading-[1.9] text-gray-600 max-w-[640px]">{description}</p>
    {ctaLabel && ctaHref && (
      <a href={ctaHref} class="mt-1 inline-flex items-center gap-2 bg-navy-900 text-white text-[14.5px] font-semibold px-[26px] py-[13px] rounded-lg hover:bg-navy-700 transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="m9 15 2 2 4-4"/></svg>
        {ctaLabel}
      </a>
    )}
    {ctaNote && <span class="text-[12.5px] text-gray-600">{ctaNote}</span>}
  </div>
</section>
