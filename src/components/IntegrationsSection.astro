---
import { integrations } from '../i18n/home';
import { pathFor } from '../i18n/paths';
import type { Lang } from '../i18n/nav';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = integrations[lang];

// Real brand marks where an official, redistributable logo exists (WhatsApp,
// Cloudflare — via the open-source Simple Icons set, used with their own
// brand color). Microsoft doesn't license the Excel glyph and AWS doesn't
// license the S3 glyph for this kind of reuse, so those two stay as clean
// custom pictograms in the site's own navy, same as the rest of the page.
const icons = [
  {
    // WhatsApp — official mark
    brand: true,
    color: '#25D366',
    path: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>',
  },
  {
    // Email — generic envelope (delivery goes via the garage's own SMTP, not a single named provider)
    brand: false,
    path: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  },
  {
    // Excel / CSV — spreadsheet grid (no licensable official Excel mark)
    brand: false,
    path: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9.5h18M3 15h18M9.5 4v16M15 4v16"/>',
  },
  {
    // Cloudflare — official mark (R2 is Cloudflare's own product; no licensable Amazon S3 mark exists)
    brand: true,
    color: '#F38020',
    path: '<path d="M16.5088 16.8447c.1475-.5068.0908-.9707-.1553-1.3154-.2246-.3164-.6045-.499-1.0615-.5205l-8.6592-.1123a.1559.1559 0 0 1-.1333-.0713c-.0283-.042-.0351-.0986-.021-.1553.0278-.084.1123-.1484.2036-.1562l8.7359-.1123c1.0351-.0489 2.1601-.8868 2.5537-1.9136l.499-1.3013c.0215-.0561.0293-.1128.0147-.168-.5625-2.5463-2.835-4.4453-5.5499-4.4453-2.5039 0-4.6284 1.6177-5.3876 3.8614-.4927-.3658-1.1187-.5625-1.794-.499-1.2026.119-2.1665 1.083-2.2861 2.2856-.0283.31-.0069.6128.0635.894C1.5683 13.171 0 14.7754 0 16.752c0 .1748.0142.3515.0352.5273.0141.083.0844.1475.1689.1475h15.9814c.0909 0 .1758-.0645.2032-.1553l.12-.4268zm2.7568-5.5634c-.0771 0-.1611 0-.2383.0112-.0566 0-.1054.0415-.127.0976l-.3378 1.1744c-.1475.5068-.0918.9707.1543 1.3164.2256.3164.6055.498 1.0625.5195l1.8437.1133c.0557 0 .1055.0263.1329.0703.0283.043.0351.1074.0214.1562-.0283.084-.1132.1485-.204.1553l-1.921.1123c-1.041.0488-2.1582.8867-2.5527 1.914l-.1406.3585c-.0283.0713.0215.1416.0986.1416h6.5977c.0771 0 .1474-.0489.169-.126.1122-.4082.1757-.837.1757-1.2803 0-2.6025-2.125-4.727-4.7344-4.727"/>',
  },
];
---

<section class="bg-white px-6 md:px-20 py-14 md:py-16">
  <div class="max-w-[720px] mx-auto text-center mb-12">
    <h2 class="text-[24px] md:text-[28px] font-bold text-navy-900">{t.heading}</h2>
    <p class="text-[15px] md:text-[16px] text-gray-600 mt-3 leading-[1.8]">{t.subheading}</p>
    <a href={pathFor(lang, 'integrations')} class="inline-flex items-center gap-1.5 text-[13.5px] font-bold text-navy-500 hover:text-navy-700 mt-3.5">
      {t.moreDetailsLabel}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class:list={[lang === 'ar' && 'rotate-180']}><path d="m9 6 6 6-6 6"/></svg>
    </a>
  </div>

  <div class="max-w-[1180px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {t.items.map((item, i) => (
      <div class="flex flex-col gap-3.5 bg-bg border border-gray-300 rounded-xl p-5 hover:-translate-y-0.5 hover:shadow-md hover:border-navy-500/30 transition-all">
        <div class="w-10 h-10 rounded-lg bg-white border border-gray-300 text-navy-900 flex items-center justify-center shrink-0">
          {icons[i].brand ? (
            <svg width="19" height="19" viewBox="0 0 24 24" fill={icons[i].color} set:html={icons[i].path} />
          ) : (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i].path} />
          )}
        </div>
        <div class="flex flex-col gap-1.5">
          <h3 class="text-[15px] font-bold text-navy-900">{item.title}</h3>
          <p class="text-[12.5px] leading-[1.8] text-gray-600">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
