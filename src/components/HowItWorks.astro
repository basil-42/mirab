---
import { howItWorks } from '../i18n/home';
import type { Lang } from '../i18n/nav';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = howItWorks[lang];
---

<section class="px-6 md:px-20 py-14 md:py-16 bg-white">
  <div class="max-w-[720px] mx-auto text-center mb-12">
    <h2 class="text-[24px] md:text-[28px] font-bold text-navy-900">{t.heading}</h2>
    <p class="text-[15px] md:text-[16px] text-gray-600 mt-3 leading-[1.8]">{t.subheading}</p>
  </div>

  <div class="max-w-[1180px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {t.steps.map((step, i) => (
      <div class="relative flex flex-col gap-3.5 bg-bg border border-gray-300 rounded-xl p-6 hover:-translate-y-0.5 hover:shadow-md hover:border-navy-500/30 transition-all">
        <span class="text-[13px] font-bold text-[#8A4A0F] tracking-wide">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="text-[16.5px] font-bold text-navy-900 leading-[1.5]">{step.title}</h3>
        <p class="text-[13.5px] leading-[1.8] text-gray-600">{step.description}</p>
      </div>
    ))}
  </div>
</section>
