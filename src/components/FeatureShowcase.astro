---
// Illustrative "rich" hero showcase for feature detail pages: a floating main
// panel over a soft brand-colored glow, surrounded by small floating chips
// that highlight real moments described in the page's own content. Content
// is passed in per-page (see billing.astro, inspection.astro, ...) so nothing
// here is fabricated — it only visualizes copy that already exists on the page.
interface Tile {
  label: string;
  value: string;
  accent?: boolean;
}
interface Row {
  label: string;
  badge: string;
  badgeVariant: 'amber' | 'urgent' | 'sent';
}
type ChipIcon = 'check' | 'alert' | 'doc' | 'mail' | 'chat' | 'link' | 'bulk' | 'signature' | 'users' | 'lock' | 'cloud' | 'import' | 'target';
interface Chip {
  icon: ChipIcon;
  title: string;
  subtitle: string;
}
interface Props {
  panelTitle: string;
  tiles: Tile[];
  rows: Row[];
  chips: Chip[];
}
const { panelTitle, tiles, rows, chips } = Astro.props;

const badgeClass: Record<Row['badgeVariant'], string> = {
  amber: 'bg-amber-500/10 text-[#8A4A0F]',
  urgent: 'bg-[#B23B2E]/10 text-[#B23B2E]',
  sent: 'bg-[#E4F3E9] text-[#2E7D4F]',
};

const CHIP_ICON_WRAP: Record<ChipIcon, string> = {
  check: 'bg-[#E4F3E9]', mail: 'bg-navy-500/10', chat: 'bg-navy-500/10', link: 'bg-navy-500/10',
  users: 'bg-navy-500/10', lock: 'bg-navy-500/10', cloud: 'bg-navy-500/10', import: 'bg-navy-500/10',
  target: 'bg-navy-500/10', signature: 'bg-navy-500/10', doc: 'bg-navy-500/10',
  alert: 'bg-amber-500/10', bulk: 'bg-amber-500/10',
};
const CHIP_ICON_COLOR: Record<ChipIcon, string> = {
  check: '#2E7D4F', alert: '#8A4A0F', bulk: '#8A4A0F',
  doc: '#2A5490', mail: '#2A5490', chat: '#2A5490', link: '#2A5490', users: '#2A5490',
  lock: '#2A5490', cloud: '#2A5490', import: '#2A5490', target: '#2A5490', signature: '#2A5490',
};
const CHIP_ICON_PATH: Record<ChipIcon, string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  alert: '<path d="M12 8v5M12 16h.01"/><circle cx="12" cy="12" r="9"/>',
  doc: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  chat: '<path d="M4 4h16v12H9l-5 4V4Z"/>',
  link: '<path d="M9 17H7a5 5 0 0 1 0-10h2M15 7h2a5 5 0 1 1 0 10h-2M8 12h8"/>',
  bulk: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="m3 6 1.3 1.3L6.5 5"/><path d="m3 12 1.3 1.3 2.2-2.3"/><path d="m3 18 1.3 1.3 2.2-2.3"/>',
  signature: '<path d="M3 17c2-4 4-6 6-6s2 4 4 4 3-6 5-6 2 3 3 3"/><path d="M4 21h16"/>',
  users: '<path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19"/><circle cx="9" cy="8" r="3.2"/><path d="M19.5 19v-1.5a3.3 3.3 0 0 0-2.3-3.15"/><path d="M14.7 4.7a3.2 3.2 0 0 1 0 6.1"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  cloud: '<path d="M17.5 19H9a5 5 0 1 1 1.3-9.8A6 6 0 0 1 22 11.5a4.5 4.5 0 0 1-4.5 7.5Z"/>',
  import: '<path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
};

function chipIconSvg(icon: ChipIcon) {
  return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${CHIP_ICON_COLOR[icon]}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${CHIP_ICON_PATH[icon]}</svg>`;
}

const chipPosClass = ['-top-6 -end-4', '-bottom-6 -end-7', '-bottom-6 -start-7'];
---

<section class="px-6 md:px-20 pt-10 md:pt-14 pb-2">
  <div class="max-w-[820px] mx-auto relative mb-10 md:mb-12">
    <!-- ambient glow -->
    <div class="absolute -inset-4 md:-inset-16 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-4 end-[6%] w-[240px] h-[240px] md:w-[320px] md:h-[320px] rounded-full bg-[radial-gradient(circle,rgba(224,147,46,.30),transparent_70%)] blur-[12px]"></div>
      <div class="absolute -bottom-8 start-[4%] w-[210px] h-[210px] md:w-[280px] md:h-[280px] rounded-full bg-[radial-gradient(circle,rgba(42,84,144,.28),transparent_70%)] blur-[12px]"></div>
    </div>

    <!-- floating chips: desktop, positioned on the panel's corners -->
    {chips.slice(0, 3).map((chip, i) => (
      <div class={`hidden md:flex absolute ${chipPosClass[i]} z-20 items-center gap-2.5 bg-white border border-gray-300 rounded-2xl px-4 py-3 shadow-[0_16px_32px_-14px_rgba(11,31,58,.3)]`}>
        <span class={`w-8 h-8 rounded-[9px] flex items-center justify-center shrink-0 ${CHIP_ICON_WRAP[chip.icon]}`} set:html={chipIconSvg(chip.icon)} />
        <span class="flex flex-col gap-0.5">
          <span class="text-[12px] font-bold text-navy-900">{chip.title}</span>
          <span class="text-[10.5px] text-gray-600">{chip.subtitle}</span>
        </span>
      </div>
    ))}

    <!-- floating chips: mobile, stacked above the panel (no overlap) -->
    <div class="flex md:hidden flex-col gap-2.5 mb-4">
      {chips.map((chip) => (
        <div class="flex items-center gap-2.5 bg-white border border-gray-300 rounded-2xl px-4 py-3">
          <span class={`w-8 h-8 rounded-[9px] flex items-center justify-center shrink-0 ${CHIP_ICON_WRAP[chip.icon]}`} set:html={chipIconSvg(chip.icon)} />
          <span class="flex flex-col gap-0.5">
            <span class="text-[12.5px] font-bold text-navy-900">{chip.title}</span>
            <span class="text-[11px] text-gray-600">{chip.subtitle}</span>
          </span>
        </div>
      ))}
    </div>

    <!-- main panel -->
    <div class="relative z-[2] bg-white border border-gray-300 rounded-[22px] p-5 md:p-6 shadow-[0_30px_60px_-24px_rgba(11,31,58,.35)]">
      <div class="flex items-center justify-between mb-4">
        <span class="text-[14px] font-bold text-navy-900">{panelTitle}</span>
        <span class="flex gap-1.5">
          <span class="w-2 h-2 rounded-full bg-gray-300"></span>
          <span class="w-2 h-2 rounded-full bg-gray-300"></span>
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        </span>
      </div>

      <div class="grid grid-cols-3 gap-3 mb-3.5">
        {tiles.map((tile) => (
          <div class="bg-bg border border-gray-300 rounded-xl p-3.5">
            <div class="text-[11px] text-gray-600 mb-1.5">{tile.label}</div>
            <div class:list={["text-[17px] md:text-[19px] font-extrabold", tile.accent ? "text-[#8A4A0F]" : "text-navy-900"]}>{tile.value}</div>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-2">
        {rows.map((row) => (
          <div class="flex items-center justify-between bg-bg border border-gray-300 rounded-[10px] px-3.5 py-2.5 text-[13px]">
            <span class="text-ink font-medium">{row.label}</span>
            <span class={`text-[11px] font-bold px-2.5 py-1 rounded-full ${badgeClass[row.badgeVariant]}`}>{row.badge}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
