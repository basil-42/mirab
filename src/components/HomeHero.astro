---
import { pathFor } from '../i18n/paths';
import type { Lang } from '../i18n/nav';

interface Props {
  lang: Lang;
  badge: string;
  title: string;
  subtitle: string;
  ctaPrimary: string;
  ctaSecondary: string;
  chips: string[];
  dashboard: {
    title: string;
    stat1Label: string; stat1Value: string;
    stat2Label: string; stat2Value: string;
    stat3Label: string; stat3Value: string;
    row1: string; row1Status: string;
    row2: string; row2Status: string;
    row3: string; row3Status: string;
  };
}
const { lang, badge, title, subtitle, ctaPrimary, ctaSecondary, chips, dashboard } = Astro.props;
---

<section class="flex flex-col lg:flex-row items-center gap-14 lg:gap-[70px] px-6 md:px-20 py-16 lg:py-24">
  <div class="flex-1 flex flex-col items-start gap-5 max-w-[560px]">
    <span class="inline-flex items-center gap-2 bg-amber-500/10 text-[#8A4A0F] text-[13px] font-semibold px-3.5 py-1.5 rounded-full">
      {badge}
    </span>
    <h1 class="text-[36px] md:text-[50px] font-bold leading-[1.3] text-navy-900">{title}</h1>
    <p class="text-[16px] md:text-[17px] leading-[1.85] text-gray-600">{subtitle}</p>
    <div class="flex items-center gap-3.5 mt-1.5 flex-wrap">
      <a href={pathFor(lang, 'contact')} class="bg-amber-500 text-[#20140A] font-bold text-[15px] px-7 py-3.5 rounded-lg hover:bg-amber-300 transition-colors">{ctaPrimary}</a>
      <a href={pathFor(lang, 'features')} class="border border-gray-300 text-navy-900 font-semibold text-[15px] px-7 py-3.5 rounded-lg hover:border-navy-500 transition-colors">{ctaSecondary}</a>
    </div>
    <div class="flex gap-6 flex-wrap mt-3">
      {chips.map((chip) => (
        <div class="flex items-center gap-2 text-[13.5px] text-gray-600">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2A5490" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          {chip}
        </div>
      ))}
    </div>
  </div>

  <div class="flex-1 w-full flex items-center justify-center relative min-h-[420px]">
    <div class="absolute w-[340px] h-[340px] md:w-[380px] md:h-[380px] rounded-full bg-amber-300/20 end-4 top-2"></div>
    <div class="relative w-full max-w-[500px] bg-white rounded-2xl shadow-2xl overflow-hidden">
      <div class="bg-navy-900 px-5 py-4 flex items-center justify-between">
        <span class="text-white font-semibold text-[14px]">{dashboard.title}</span>
        <div class="flex gap-1.5">
          <div class="w-2 h-2 rounded-full bg-amber-500"></div>
          <div class="w-2 h-2 rounded-full bg-white/30"></div>
          <div class="w-2 h-2 rounded-full bg-white/30"></div>
        </div>
      </div>
      <div class="p-5 flex flex-col gap-4">
        <div class="grid grid-cols-3 gap-2.5">
          <div class="bg-bg rounded-lg p-3 flex flex-col gap-1">
            <span class="text-[11px] text-gray-600">{dashboard.stat1Label}</span>
            <span class="text-[20px] font-bold text-navy-900">{dashboard.stat1Value}</span>
          </div>
          <div class="bg-bg rounded-lg p-3 flex flex-col gap-1">
            <span class="text-[11px] text-gray-600">{dashboard.stat2Label}</span>
            <span class="text-[20px] font-bold text-navy-900">{dashboard.stat2Value}</span>
          </div>
          <div class="bg-amber-500/10 rounded-lg p-3 flex flex-col gap-1">
            <span class="text-[11px] text-[#8A4A0F]">{dashboard.stat3Label}</span>
            <span class="text-[20px] font-bold text-[#8A4A0F]">{dashboard.stat3Value}</span>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between px-3.5 py-3 border border-gray-300 rounded-lg">
            <span class="text-[13px] text-ink font-medium">{dashboard.row1}</span>
            <span class="text-[11px] font-semibold text-[#2E7D4F] bg-[#E4F3E9] px-2.5 py-1 rounded-full">{dashboard.row1Status}</span>
          </div>
          <div class="flex items-center justify-between px-3.5 py-3 border border-gray-300 rounded-lg">
            <span class="text-[13px] text-ink font-medium">{dashboard.row2}</span>
            <span class="text-[11px] font-semibold text-[#8A4A0F] bg-amber-500/10 px-2.5 py-1 rounded-full">{dashboard.row2Status}</span>
          </div>
          <div class="flex items-center justify-between px-3.5 py-3 border border-gray-300 rounded-lg">
            <span class="text-[13px] text-ink font-medium">{dashboard.row3}</span>
            <span class="text-[11px] font-semibold text-gray-600 bg-bg px-2.5 py-1 rounded-full">{dashboard.row3Status}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
