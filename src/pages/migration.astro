---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
import { migrationPage } from '../i18n/migration';

const lang = 'ar' as const;
const t = migrationPage[lang];
---

<BaseLayout
  lang={lang}
  slug="migration"
  title="دليل الانتقال | مِرآب"
  description="استيراد آمن بمعاينة كاملة قبل التنفيذ، ومطابقة ذكية تمنع تكرار العملاء أثناء الانتقال من نظامك القديم إلى مِرآب."
>
  <PageHero eyebrow={t.eyebrow} title={t.title} description={t.description} />

  <section class="px-6 md:px-20 pt-14 pb-4 md:pt-16 bg-white">
    <div class="max-w-[1100px] mx-auto relative px-3 md:px-5">
      <div class="hidden sm:block absolute top-[26px] start-[12.5%] end-[12.5%] h-px bg-gray-300"></div>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-10 sm:gap-4 relative">
        {t.steps.map((step, i) => (
          <div class="flex flex-col items-center text-center">
            <div class="w-[52px] h-[52px] rounded-full bg-navy-900 text-white flex items-center justify-center font-bold text-[17px] mb-4 ring-[6px] ring-white">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="text-[14.5px] font-bold text-navy-900 mb-1.5 max-w-[210px]">{step.title}</h3>
            <p class="text-[12.5px] leading-[1.8] text-gray-600 max-w-[210px]">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 md:px-20 pt-9 pb-14 md:pb-16 bg-white">
    <div class="max-w-[820px] mx-auto bg-bg border border-gray-300 rounded-2xl p-7 md:p-8 flex items-start gap-[18px]">
      <div class="w-10 h-10 rounded-[10px] bg-navy-900 flex items-center justify-center shrink-0">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M12 15l4-4M12 15l-4-4"/><path d="M5 19h14"/></svg>
      </div>
      <div class="flex flex-col gap-1.5">
        <h3 class="text-[15.5px] font-bold text-navy-900">{t.reassuranceTitle}</h3>
        <p class="text-[13.5px] leading-[1.9] text-gray-600">{t.reassuranceDescription}</p>
      </div>
    </div>
  </section>

  <CTABanner lang={lang} title={t.ctaBannerTitle} ctaLabel={t.ctaBannerLabel} />
</BaseLayout>
