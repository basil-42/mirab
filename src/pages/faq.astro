---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQList from '../components/FAQList.astro';
import CTABanner from '../components/CTABanner.astro';
import { faqPage } from '../i18n/faq';

const p = faqPage.ar;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout lang="ar" slug="faq" title="الأسئلة الشائعة — مِرآب" description="إجابات مباشرة على أكثر الأسئلة تكرارًا حول الأمان، النقل من نظام قديم، والعمل اليومي مع مِرآب." structuredData={structuredData}>
  <PageHero eyebrow={p.eyebrow} title={p.title} description={p.description} />

  <section class="px-6 md:px-20 py-4 md:py-10">
    <FAQList items={p.items} />
  </section>

  <CTABanner lang="ar" title={p.ctaTitle} ctaLabel="تواصل معنا" />
</BaseLayout>
