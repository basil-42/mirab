---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout lang="ar" slug="contact" title="تواصل معنا — مِرآب" description="جاهزون للإجابة على أسئلتك أو ترتيب عرض توضيحي مباشر لنظام إدارة الكراج.">
  <PageHero eyebrow="تواصل معنا" title="جاهزون للإجابة على أسئلتك" description="راسلنا لترتيب عرض توضيحي مباشر، أو لمناقشة كيف يلائم مِرآب ورشتك تحديداً." />

  <section class="px-6 md:px-20 py-10 md:py-16">
    <div class="max-w-[900px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">

      <div class="flex flex-col gap-6">
        <div class="bg-white border border-gray-300 rounded-xl p-6 flex flex-col gap-1.5">
          <span class="text-[12px] font-semibold text-gray-600 uppercase tracking-wide">البريد الإلكتروني</span>
          <span class="text-[16px] font-semibold text-navy-900">[البريد الإلكتروني]</span>
        </div>
        <div class="bg-white border border-gray-300 rounded-xl p-6 flex flex-col gap-1.5">
          <span class="text-[12px] font-semibold text-gray-600 uppercase tracking-wide">واتساب</span>
          <span class="text-[16px] font-semibold text-navy-900">[رقم واتساب]</span>
        </div>
        <div class="bg-white border border-gray-300 rounded-xl p-6 flex flex-col gap-1.5">
          <span class="text-[12px] font-semibold text-gray-600 uppercase tracking-wide">الموقع</span>
          <span class="text-[16px] font-semibold text-navy-900">الدوحة، قطر</span>
        </div>
      </div>

      <form class="flex flex-col gap-4 bg-white border border-gray-300 rounded-xl p-6">
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-ink" for="name">الاسم</label>
          <input id="name" name="name" type="text" class="border border-gray-300 rounded-lg px-3.5 py-2.5 text-[14px] focus:outline-none focus:border-navy-500" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-ink" for="phone">رقم الهاتف</label>
          <input id="phone" name="phone" type="tel" class="border border-gray-300 rounded-lg px-3.5 py-2.5 text-[14px] focus:outline-none focus:border-navy-500" dir="ltr" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-ink" for="message">رسالتك</label>
          <textarea id="message" name="message" rows="4" class="border border-gray-300 rounded-lg px-3.5 py-2.5 text-[14px] focus:outline-none focus:border-navy-500 resize-none"></textarea>
        </div>
        <button type="submit" class="bg-navy-900 text-white font-semibold text-[14.5px] py-3 rounded-lg hover:bg-navy-700 transition-colors">
          إرسال
        </button>
        <p class="text-[12px] text-gray-600 leading-relaxed">* هذا النموذج يحتاج ربطًا بخدمة إرسال بريد أو Webhook عند النشر الفعلي.</p>
      </form>

    </div>
  </section>
</BaseLayout>
