---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LegalSections from '../components/LegalSections.astro';
import CTABanner from '../components/CTABanner.astro';
import { privacyPage } from '../i18n/legal';

const p = privacyPage.ar;
---

<BaseLayout lang="ar" slug="privacy" title="سياسة الخصوصية — مِرآب" description="كيف نجمع بيانات زوار موقعنا ومستخدمي نظام مِرآب، وكيف نستخدمها ونحميها.">
  <PageHero eyebrow={p.eyebrow} title={p.title} description={p.description} />
  <LegalSections sections={p.sections} lastUpdated={p.lastUpdated} />
  <CTABanner lang="ar" title={p.ctaTitle} ctaLabel="تواصل معنا" />
</BaseLayout>
