---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LegalSections from '../../components/LegalSections.astro';
import CTABanner from '../../components/CTABanner.astro';
import { termsPage } from '../../i18n/legal';

const p = termsPage.en;
---

<BaseLayout lang="en" slug="terms" title="Terms & Conditions — Mirab" description="The terms that govern your use of our website and the Mirab garage management system.">
  <PageHero eyebrow={p.eyebrow} title={p.title} description={p.description} />
  <LegalSections sections={p.sections} lastUpdated={p.lastUpdated} />
  <CTABanner lang="en" title={p.ctaTitle} ctaLabel="Contact Us" />
</BaseLayout>
