---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import { aboutPage } from '../../i18n/about';

const lang = 'en' as const;
const t = aboutPage[lang];

// Simple, feather-style icons — matching the outline language used across the
// rest of the site. No brand marks here, just plain pictograms.
const ICONS: Record<string, string> = {
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/>',
  cycle: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v5h-5"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/>',
  support: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3Z"/><path d="M3 19a2 2 0 0 0 2 2h1v-6H3Z"/>',
  dev: '<path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>',
  onboarding: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>',
};
---

<BaseLayout
  lang={lang}
  slug="about"
  title="About Mirab | Mirab"
  description="The Mirab story — from a simple fix for the paperwork problem in service centers, to a complete system that runs the entire operation."
>
  <PageHero eyebrow={t.eyebrow} title={t.title} description={t.description} />

  <section class="px-6 md:px-20 py-12 md:py-16 bg-white">
    <div class="max-w-[1000px] mx-auto grid grid-cols-1 md:grid-cols-[180px_1fr] gap-8 md:gap-10 items-start">
      <div class="w-[88px] h-[88px] rounded-[20px] bg-bg border border-gray-300 flex items-center justify-center text-navy-700">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h10a1 1 0 0 1 1 1v14"/><path d="M5 6h10a1 1 0 0 1 1 1v14H6a1 1 0 0 1-1-1V6Z"/><path d="M8 11h4M8 15h5"/></svg>
      </div>
      <div>
        <div class="text-[12px] font-bold text-gray-600 uppercase tracking-wide mb-2.5">{t.problem.label}</div>
        <h2 class="text-[22px] font-bold text-navy-900 mb-3.5">{t.problem.heading}</h2>
        <p class="text-[15.5px] leading-[2] text-gray-600 max-w-[680px]">{t.problem.body}</p>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-20 py-12 md:py-16 bg-bg">
    <div class="max-w-[640px] mx-auto text-center mb-10">
      <h2 class="text-[24px] md:text-[28px] font-bold text-navy-900">{t.evolve.heading}</h2>
    </div>
    <div class="max-w-[920px] mx-auto grid grid-cols-1 sm:grid-cols-[1fr_56px_1fr] gap-5 sm:gap-0 items-center">
      <div class="bg-white border border-gray-300 rounded-2xl p-7">
        <div class="text-[12px] font-bold text-[#8A4A0F] uppercase tracking-wide mb-2.5">{t.evolve.startLabel}</div>
        <p class="text-[14.5px] leading-[1.85] text-ink">{t.evolve.startBody}</p>
      </div>
      <div class="flex items-center justify-center text-gray-600 -rotate-90 sm:rotate-180">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H6M12 6l-7 6 7 6"/></svg>
      </div>
      <div class="bg-navy-900 border border-navy-900 rounded-2xl p-7">
        <div class="text-[12px] font-bold text-amber-300 uppercase tracking-wide mb-2.5">{t.evolve.nowLabel}</div>
        <p class="text-[14.5px] leading-[1.85] text-white/85">{t.evolve.nowBody}</p>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-20 py-12 md:py-16 bg-white">
    <div class="max-w-[640px] mx-auto text-center mb-11">
      <h2 class="text-[24px] md:text-[28px] font-bold text-navy-900">{t.differentiators.heading}</h2>
    </div>
    <div class="max-w-[1000px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-y-9 gap-x-12">
      {t.differentiators.items.map((item) => (
        <div class="flex items-start gap-4">
          <div class="w-[42px] h-[42px] rounded-[11px] bg-bg border border-gray-300 text-navy-700 flex items-center justify-center shrink-0">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[item.icon]} />
          </div>
          <div>
            <h3 class="text-[15px] font-bold text-navy-900 mb-1.5">{item.title}</h3>
            <p class="text-[13.5px] leading-[1.8] text-gray-600">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTABanner lang={lang} title={t.ctaBannerTitle} ctaLabel={t.ctaBannerLabel} />
</BaseLayout>
