---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<BaseLayout lang="en" slug="contact" title="Contact Us — Mirab" description="Ready to answer your questions or arrange a live demo of the garage management system.">
  <PageHero eyebrow="Contact Us" title="Ready to answer your questions" description="Reach out to arrange a live demo, or to discuss how Mirab fits your garage specifically." />

  <section class="px-6 md:px-20 py-10 md:py-16">
    <div class="max-w-[900px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">

      <div class="flex flex-col gap-6">
        <div class="bg-white border border-gray-300 rounded-xl p-6 flex flex-col gap-1.5">
          <span class="text-[12px] font-semibold text-gray-600 uppercase tracking-wide">Email</span>
          <span class="text-[16px] font-semibold text-navy-900">[Email address]</span>
        </div>
        <div class="bg-white border border-gray-300 rounded-xl p-6 flex flex-col gap-1.5">
          <span class="text-[12px] font-semibold text-gray-600 uppercase tracking-wide">WhatsApp</span>
          <span class="text-[16px] font-semibold text-navy-900">[WhatsApp number]</span>
        </div>
        <div class="bg-white border border-gray-300 rounded-xl p-6 flex flex-col gap-1.5">
          <span class="text-[12px] font-semibold text-gray-600 uppercase tracking-wide">Location</span>
          <span class="text-[16px] font-semibold text-navy-900">Doha, Qatar</span>
        </div>
      </div>

      <form class="flex flex-col gap-4 bg-white border border-gray-300 rounded-xl p-6">
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-ink" for="name">Name</label>
          <input id="name" name="name" type="text" class="border border-gray-300 rounded-lg px-3.5 py-2.5 text-[14px] focus:outline-none focus:border-navy-500" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-ink" for="phone">Phone Number</label>
          <input id="phone" name="phone" type="tel" class="border border-gray-300 rounded-lg px-3.5 py-2.5 text-[14px] focus:outline-none focus:border-navy-500" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-ink" for="message">Message</label>
          <textarea id="message" name="message" rows="4" class="border border-gray-300 rounded-lg px-3.5 py-2.5 text-[14px] focus:outline-none focus:border-navy-500 resize-none"></textarea>
        </div>
        <button type="submit" class="bg-navy-900 text-white font-semibold text-[14.5px] py-3 rounded-lg hover:bg-navy-700 transition-colors">
          Send
        </button>
        <p class="text-[12px] text-gray-600 leading-relaxed">* This form needs to be wired to an email service or webhook before going live.</p>
      </form>

    </div>
  </section>
</BaseLayout>
