---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LegalSections from '../../components/LegalSections.astro';
import CTABanner from '../../components/CTABanner.astro';
import { privacyPage } from '../../i18n/legal';

const p = privacyPage.en;
---

<BaseLayout lang="en" slug="privacy" title="Privacy Policy — Mirab" description="How we collect data from our website visitors and Mirab system users, and how we use and protect it.">
  <PageHero eyebrow={p.eyebrow} title={p.title} description={p.description} />
  <LegalSections sections={p.sections} lastUpdated={p.lastUpdated} />
  <CTABanner lang="en" title={p.ctaTitle} ctaLabel="Contact Us" />
</BaseLayout>
