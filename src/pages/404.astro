---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="ar" slug="" title="الصفحة غير موجودة — مِرآب | Page Not Found — Mirab" description="الصفحة التي تبحث عنها غير موجودة." noindex>
  <section class="px-6 md:px-20 py-20 md:py-28">
    <div class="max-w-[640px] mx-auto text-center flex flex-col items-center gap-7">
      <span class="text-[76px] md:text-[96px] font-bold leading-none text-navy-900">
        4<span class="text-[#8A4A0F]">0</span>4
      </span>

      <div class="flex flex-col gap-2">
        <h1 class="text-[24px] md:text-[28px] font-bold text-navy-900 font-ar">عذرًا، الصفحة غير موجودة</h1>
        <p class="text-[15px] leading-[1.85] text-gray-600 font-ar">قد يكون الرابط غير صحيح أو تم نقل الصفحة.</p>
      </div>

      <div class="w-10 h-px bg-gray-300"></div>

      <div class="flex flex-col gap-2" dir="ltr">
        <h2 class="text-[18px] font-semibold text-navy-900 font-en">Sorry, this page doesn't exist</h2>
        <p class="text-[14px] leading-[1.8] text-gray-600 font-en">The link may be broken, or the page may have moved.</p>
      </div>

      <div class="flex items-center gap-3.5 mt-2 flex-wrap justify-center">
        <a href="/" class="bg-navy-900 text-white font-semibold text-[14.5px] px-6 py-3 rounded-lg hover:bg-navy-700 transition-colors font-ar">العودة للرئيسية</a>
        <a href="/en/" class="border border-gray-300 text-navy-900 font-semibold text-[14.5px] px-6 py-3 rounded-lg hover:border-navy-500 transition-colors font-en">Back to Homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
