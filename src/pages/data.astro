---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import FeatureDetailGrid from '../components/FeatureDetailGrid.astro';
import CTABanner from '../components/CTABanner.astro';
import { pathFor } from '../i18n/paths';

const showcase = {
  panelTitle: 'معاينة الاستيراد',
  tiles: [
    { label: 'سجلات جاهزة للاستيراد', value: '342' },
    { label: 'تكرارات تم اكتشافها', value: '12', accent: true },
    { label: 'أخطاء بالبيانات', value: '3' },
  ],
  rows: [
    { label: 'أحمد الكواري — 5551 2345', badge: 'عميل مطابق', badgeVariant: 'sent' as const },
    { label: 'سطر 87 — رقم هاتف ناقص', badge: 'يتطلب مراجعة', badgeVariant: 'amber' as const },
  ],
  chips: [
    { icon: 'check' as const, title: 'معاينة قبل التنفيذ', subtitle: 'Dry Run — لا تغييرات فعلية بعد' },
    { icon: 'alert' as const, title: 'تكرار محتمل', subtitle: 'مطابقة تلقائية عبر الهاتف' },
    { icon: 'export' as const, title: 'تصدير كامل', subtitle: 'CSV / Excel' },
  ],
};

const items = [
  { icon: 'import' as const, title: 'استيراد جماعي عبر CSV', desc: 'استيراد مئات أو آلاف السجلات دفعة واحدة (عملاء، فواتير، بطاقات عمل، عروض أسعار) من ملف Excel/CSV، مع معاينة كاملة للنتائج قبل التنفيذ الفعلي (Dry Run) لتفادي أي خطأ في البيانات.' },
  { icon: 'link' as const, title: 'مطابقة ذكية للعملاء', desc: 'مطابقة تلقائية للسجلات المستوردة مع العملاء الحاليين عبر رقم الهاتف (بغض النظر عن صيغة كتابته)، لمنع تكرار العملاء عند الاستيراد.' },
  { icon: 'export' as const, title: 'تصدير شامل', desc: 'تصدير كامل لأي قائمة أو تقرير — العملاء، الفواتير، سجل التدقيق — إلى ملفات CSV أو Excel جاهزة للاستخدام خارج النظام.' },
];
---

<BaseLayout lang="ar" slug="data" title="استيراد وتصدير البيانات — مِرآب" description="استيراد جماعي عبر CSV مع معاينة قبل التنفيذ، ومطابقة ذكية للعملاء لمنع التكرار.">
  <PageHero eyebrow="استيراد وتصدير البيانات" title="انتقل لمِرآب دون فقدان بياناتك القديمة" description="استيراد آمن بمعاينة كاملة قبل التنفيذ، ومطابقة ذكية تمنع تكرار العملاء أثناء النقل." />

  <FeatureShowcase panelTitle={showcase.panelTitle} tiles={showcase.tiles} rows={showcase.rows} chips={showcase.chips} />

  <FeatureDetailGrid items={items} label="تفاصيل الميزة" />

  <section class="px-6 md:px-20 pb-10 md:pb-14">
    <div class="max-w-[820px] mx-auto">
      <a href={pathFor('ar', 'migration')} class="flex items-center justify-between gap-4 bg-navy-900/5 border border-navy-900/10 rounded-xl px-6 py-5 hover:border-navy-500/40 transition-colors">
        <div class="flex flex-col gap-1">
          <span class="text-[15px] font-bold text-navy-900">تريد تفاصيل خطوة بخطوة؟</span>
          <span class="text-[13.5px] text-gray-600">اطّلع على دليل الانتقال الكامل من بياناتك القديمة إلى مِرآب.</span>
        </div>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B1F3A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 rotate-180"><path d="m9 6 6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <CTABanner lang="ar" title="انقل بيانات ورشتك بأمان في دقائق." ctaLabel="ابدأ الآن مجانًا" />
</BaseLayout>
