---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
import { comparisonPage } from '../i18n/comparison';

const lang = 'ar' as const;
const t = comparisonPage[lang];
---

<BaseLayout
  lang={lang}
  slug="comparison"
  title="الطريقة التقليدية مقابل مِرآب | مِرآب"
  description="نفس العمل اليومي لورشتك — بأثر مختلف تمامًا على وقتك ودقتك. مقارنة تفصيلية بين الطريقة التقليدية ومِرآب."
>
  <PageHero eyebrow={t.eyebrow} title={t.title} description={t.description} />

  <section class="px-6 md:px-20 py-10 md:py-14 bg-white">
    <div class="max-w-[1080px] mx-auto">
      <div class="hidden sm:grid grid-cols-2 border border-gray-300 rounded-t-2xl overflow-hidden">
        <div class="px-5 md:px-7 py-4 bg-bg flex items-center gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5B6472" stroke-width="2.4" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg>
          <span class="text-[12px] md:text-[13.5px] font-bold text-gray-600 uppercase tracking-wide">{t.beforeLabel}</span>
        </div>
        <div class="px-5 md:px-7 py-4 bg-navy-900 flex items-center gap-2.5 border-s border-white/10">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F0B968" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="text-[12px] md:text-[13.5px] font-bold text-white uppercase tracking-wide">{t.afterLabel}</span>
        </div>
      </div>

      <div class="border border-gray-300 rounded-2xl sm:rounded-t-none overflow-hidden flex flex-col gap-0">
        {t.rows.map((row, i) => (
          <div class:list={["grid grid-cols-1 sm:grid-cols-2 border-gray-300", i > 0 && "border-t"]}>
            <div class="px-5 md:px-7 py-4 sm:py-5 flex items-center gap-2.5 sm:gap-0 bg-bg sm:bg-transparent">
              <svg width="14" height="14" class="sm:hidden shrink-0" viewBox="0 0 24 24" fill="none" stroke="#5B6472" stroke-width="2.6" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg>
              <span class="text-[13px] md:text-[14px] leading-[1.75] text-gray-600 line-through decoration-gray-300">{row.before}</span>
            </div>
            <div class="px-5 md:px-7 py-4 sm:py-5 flex flex-col gap-1.5 justify-center bg-amber-500/5 border-t sm:border-t-0 sm:border-s border-gray-300">
              <span class="text-[13.5px] md:text-[14.5px] leading-[1.75] font-semibold text-navy-900 flex items-center gap-2">
                <svg width="14" height="14" class="sm:hidden shrink-0" viewBox="0 0 24 24" fill="none" stroke="#2A5490" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                {row.after}
              </span>
              <span class="text-[12px] md:text-[12.5px] leading-[1.7] text-gray-600">{row.afterDetail}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner lang={lang} title={t.ctaBannerTitle} ctaLabel={t.ctaBannerLabel} />
</BaseLayout>
